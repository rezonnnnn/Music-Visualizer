// Icon, version details and manifest that Windows shows for music-visualizer.exe.
#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "rezonnnnn"
            VALUE "FileDescription", "Music Visualizer"
            VALUE "FileVersion", "0.4.0"
            VALUE "InternalName", "music-visualizer"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "music-visualizer.exe"
            VALUE "ProductName", "Music Visualizer"
            VALUE "ProductVersion", "0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
